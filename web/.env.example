# Copy to web/.env.local for local development. Use Render environment
# variables in production. These values are read only by the Next.js server.
OPENAI_API_KEY=your-openai-api-key
# Development override only. Production uses the fixed production model.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst

# Development Vertex image generation.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account-key.json
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Local defaults. Replace with the RunPod endpoints for a remote deployment.
IRODORI_TTS_BASE_URL=http://127.0.0.1:8088
IRODORI_TTS_MODEL=irodori-tts
# IRODORI_TTS_API_KEY=shared-with-irodori
MOVIE_WORKER_URL=http://127.0.0.1:8090
TOONOUT_WORKER_URL=http://127.0.0.1:8091
# Required across machines; the local launcher can read existing token files.
# MOVIE_WORKER_TOKEN=shared-with-movie
# TOONOUT_WORKER_TOKEN=shared-with-toonout
# Local token-file directories default to ../.movie-data and ../.toonout-data.
# MOVIE_DATA_DIR=C:/dev/chibichara-studio.ver2/.movie-data
# TOONOUT_DATA_DIR=C:/dev/chibichara-studio.ver2/.toonout-data

# Movie Serverless on Runpod + private Cloudflare R2 (24-hour retention).
# Enable these on Render instead of MOVIE_WORKER_URL.
# MOVIE_BACKEND=runpod
# RUNPOD_MOVIE_ENDPOINT_ID=your-endpoint-id
# RUNPOD_API_KEY=your-runpod-api-key
# VOICE_BACKEND=runpod
# TOONOUT_BACKEND=runpod
# RUNPOD_VOICE_ENDPOINT_ID=your-voice-endpoint-id
# RUNPOD_TOONOUT_ENDPOINT_ID=your-toonout-endpoint-id
# MOVIE_S3_BUCKET=chibichara-movie-temp
# MOVIE_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# MOVIE_S3_REGION=auto
# MOVIE_S3_ACCESS_KEY_ID=your-r2-access-key-id
# MOVIE_S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# MOVIE_S3_FORCE_PATH_STYLE=true

# Local setup only: npm run r2:configure adds the 1-day R2 lifecycle rule.
# These management credentials are not needed on Render or Runpod.
# CLOUDFLARE_ACCOUNT_ID=your-32-character-account-id
# CLOUDFLARE_API_TOKEN=your-r2-configuration-api-token
