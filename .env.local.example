GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account-key.json

# Optional. Defaults to Gemini 3.1 Flash Image (Nano Banana 2).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Irodori-TTS OpenAI-compatible inference server.
IRODORI_TTS_BASE_URL=http://127.0.0.1:8088
IRODORI_TTS_MODEL=irodori-tts
IRODORI_TTS_TIMEOUT_MS=900000
# IRODORI_TTS_API_KEY=change-me

# Movie: separate local worker. TTS and Movie share this machine's filesystem.
MOVIE_WORKER_URL=http://127.0.0.1:8090
GEMINI_AUDIO_MODEL=gemini-2.5-flash
MOVIE_ASR_MODEL=large-v3
# MOVIE_DATA_DIR=C:/dev/chibichara-studio.ver2/.movie-data
# MOVIE_MAX_BYTES=21474836480
# MOVIE_WORKER_TOKEN is optional: shared private service.token is created at startup.
