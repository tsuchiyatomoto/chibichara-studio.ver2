GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account-key.json

# Optional. Defaults to Gemini 3.1 Flash Image (Nano Banana 2).
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Irodori-TTS OpenAI-compatible inference server.
IRODORI_TTS_BASE_URL=http://127.0.0.1:8088
IRODORI_TTS_MODEL=irodori-tts
IRODORI_TTS_TIMEOUT_MS=900000
# IRODORI_TTS_API_KEY=change-me
