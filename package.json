{
  "name": "chibichara-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:web": "npm --prefix web ci",
    "dev": "npm --prefix web run dev",
    "dev:background": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-background.ps1 -Service dev",
    "tts:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-irodori-tts.ps1",
    "tts:background": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-background.ps1 -Service tts",
    "tts:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/stop-irodori-tts.ps1",
    "movie:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/setup-movie.ps1",
    "movie:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-movie.ps1",
    "movie:background": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-background.ps1 -Service movie",
    "movie:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/test-movie.ps1",
    "toonout:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/setup-toonout.ps1",
    "toonout:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-toonout.ps1",
    "toonout:background": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/start-background.ps1 -Service toonout",
    "build": "npm --prefix web run build",
    "start": "npm --prefix web start",
    "lint": "npm --prefix web run lint",
    "test:web": "npm --prefix web test",
    "jobs:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/local/test-jobs.ps1"
  }
}
