# Copy to .env.runpod at the repository root, or set these in the Pod template.
# All three tokens are required. Use separate random values, and configure the
# matching values in Render. Never use NEXT_PUBLIC_ for these variables.
IRODORI_API_KEY=
MOVIE_WORKER_TOKEN=
TOONOUT_WORKER_TOKEN=

# Vertex AI for Movie audio analysis.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_AUDIO_MODEL=gemini-2.5-flash
MOVIE_ASR_MODEL=large-v3
# Choose ONE credential source:
# GOOGLE_SERVICE_ACCOUNT_JSON=<the complete service-account JSON, as a secret>
# GOOGLE_APPLICATION_CREDENTIALS=/workspace/secrets/service-account.json

# Internal Movie -> TTS connection. Bootstrap derives the matching API key.
IRODORI_TTS_BASE_URL=http://127.0.0.1:8088
# IRODORI_TTS_API_KEY must match IRODORI_API_KEY if explicitly set.

# Defaults match the current local configuration; override for your GPU.
IRODORI_HF_CHECKPOINT=phasefield-audio/Irodori-TTS-v4.1-Anime
IRODORI_MODEL_DEVICE=cuda
IRODORI_CODEC_DEVICE=cuda
IRODORI_MODEL_PRECISION=fp32
IRODORI_CODEC_PRECISION=fp32
IRODORI_SILENTCIPHER_WATERMARK=false
IRODORI_PRELOAD=false
IRODORI_SPEAKER_INVERSION_MAX_STEPS=3000
TOONOUT_DEVICE=cuda

# Optional: private/gated Hugging Face repositories.
# HF_TOKEN=
# Runtime defaults: /workspace/data/{movie,toonout,irodori}, /workspace/cache.
# Speech jobs: /workspace/data/irodori/speech-jobs (24-hour result retention).
# These are container paths; do not reuse Windows paths from gpu/.env.local.
