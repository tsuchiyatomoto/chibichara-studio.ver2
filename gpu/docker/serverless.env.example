# Shared Movie/Voice/ToonOut queue image. Never commit actual credentials.
IRODORI_API_KEY=
MOVIE_WORKER_TOKEN=
TOONOUT_WORKER_TOKEN=
GOOGLE_CLOUD_PROJECT=
# Provide either GOOGLE_SERVICE_ACCOUNT_JSON or GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Private Cloudflare R2 bucket, with movie-temp/ deleted after 1 day.
MOVIE_S3_BUCKET=chibichara-movie-temp
MOVIE_S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
MOVIE_S3_REGION=auto
MOVIE_S3_ACCESS_KEY_ID=
MOVIE_S3_SECRET_ACCESS_KEY=
MOVIE_S3_FORCE_PATH_STYLE=true

# Always local: never put SQLite or this scratch directory on a network mount.
MOVIE_DATA_DIR=/tmp/chibichara-movie-api
MOVIE_LOCAL_TMP=/tmp/chibichara-movie
CHIBICHARA_DATA_ROOT=/tmp/chibichara-data
TMPDIR=/tmp/chibichara-tmp

# Local model cache; no Network Volume is required.
HF_HOME=/tmp/chibichara-cache/huggingface
TORCH_HOME=/tmp/chibichara-cache/torch
XDG_CACHE_HOME=/tmp/chibichara-cache
# Shared image role: movie (default), voice or toonout.
# SERVERLESS_ROLE=voice
