# Copy to gpu/.env.local for Movie and ToonOut development.
# Irodori has its own settings example at irodori/.env.example.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account-key.json
GEMINI_AUDIO_MODEL=gemini-2.5-flash
MOVIE_ASR_MODEL=large-v3

# Movie and Irodori must see the same absolute paths to voice snapshots.
IRODORI_TTS_BASE_URL=http://127.0.0.1:8088
# IRODORI_TTS_API_KEY=shared-with-irodori
# The Windows TTS launcher defaults IRODORI_SPEECH_JOBS_DIR to ../.speech-jobs.
# MOVIE_DATA_DIR=C:/dev/chibichara-studio.ver2/.movie-data
# MOVIE_WORKER_TOKEN=shared-with-web

TOONOUT_DEVICE=auto
# TOONOUT_DATA_DIR=C:/dev/chibichara-studio.ver2/.toonout-data
# TOONOUT_WORKER_TOKEN=shared-with-web
