# Server
IRODORI_HOST=0.0.0.0
IRODORI_PORT=8088
# Docker build backend: cu128, rocm, or cpu.
IRODORI_TTS_BACKEND=cu128
# Optional. When set, clients must send Authorization: Bearer <value>.
# IRODORI_API_KEY=change-me

# Model
IRODORI_HF_CHECKPOINT=Aratako/Irodori-TTS-v4-Small
# IRODORI_CHECKPOINT=/models/model.safetensors
IRODORI_CODEC_REPO=Aratako/Semantic-DACVAE-Japanese-32dim
IRODORI_MODEL_NAME=irodori-tts
IRODORI_MODEL_DEVICE=auto
IRODORI_CODEC_DEVICE=auto
IRODORI_MODEL_PRECISION=fp32
IRODORI_CODEC_PRECISION=fp32
# Keep compile disabled when using per-request irodori.lora_adapter.
IRODORI_COMPILE_MODEL=false
IRODORI_COMPILE_DYNAMIC=false
# SilentCipher modifies the waveform and can be heard as metallic noise.
IRODORI_SILENTCIPHER_WATERMARK=false
IRODORI_PRELOAD=false
IRODORI_MODEL_LOAD_TIMEOUT=300
IRODORI_MAX_CONCURRENT_SYNTHESIS=1
IRODORI_SYNTHESIS_WAIT_TIMEOUT=300
IRODORI_SPEECH_JOBS_DIR=speech-jobs
IRODORI_SPEECH_JOB_TTL_HOURS=24
IRODORI_EMPTY_CACHE_INTERVAL=10

# Voices
IRODORI_VOICES_DIR=voices
# IRODORI_DEFAULT_VOICE=sample
IRODORI_ALLOW_NO_REF_VOICE=true

# Owner-scoped application voice assets (never mixed into IRODORI_VOICES_DIR)
IRODORI_VOICE_ASSETS_DIR=voice-assets
IRODORI_VOICE_ASSET_MAX_FILE_BYTES=10485760
IRODORI_VOICE_ASSET_MAX_ASSETS_PER_OWNER=50
IRODORI_VOICE_ASSET_MAX_TOTAL_BYTES_PER_OWNER=262144000
IRODORI_VOICE_ASSET_TEMPORARY_TTL_HOURS=24
IRODORI_VOICE_ASSET_CLEANUP_INTERVAL_SECONDS=300

# Speaker Inversion background jobs
IRODORI_SPEAKER_INVERSION_ENABLED=true
# Optional path to a full Irodori-TTS checkout containing train.py and configs/.
# Local uv installations are auto-detected when this is unset.
# IRODORI_SPEAKER_INVERSION_TRAINING_ROOT=/path/to/Irodori-TTS
IRODORI_SPEAKER_INVERSION_JOBS_DIR=speaker-inversion-jobs
IRODORI_SPEAKER_INVERSION_RESULT_TTL_HOURS=24
IRODORI_SPEAKER_INVERSION_CLEANUP_INTERVAL_SECONDS=300
IRODORI_SPEAKER_INVERSION_MIN_SAMPLES=5
IRODORI_SPEAKER_INVERSION_MAX_SAMPLES=20
IRODORI_SPEAKER_INVERSION_MAX_FILE_BYTES=26214400
IRODORI_SPEAKER_INVERSION_MAX_TOTAL_BYTES=104857600
IRODORI_SPEAKER_INVERSION_MAX_STEPS=3000
IRODORI_SPEAKER_INVERSION_BATCH_SIZE=1
IRODORI_SPEAKER_INVERSION_GRADIENT_ACCUMULATION_STEPS=1
IRODORI_SPEAKER_INVERSION_NUM_WORKERS=0
IRODORI_SPEAKER_INVERSION_PRECISION=bf16
IRODORI_SPEAKER_INVERSION_DEVICE=auto

# Defaults for /v1/audio/speech
IRODORI_DEFAULT_RESPONSE_FORMAT=wav
# Unset: model default (RF: 40, MeanFlow: 4).
# IRODORI_DEFAULT_NUM_STEPS=40
IRODORI_DEFAULT_T_SCHEDULE_MODE=linear
IRODORI_DEFAULT_SWAY_COEFF=-1.0
IRODORI_DEFAULT_DURATION_SCALE=1.0
IRODORI_DEFAULT_CFG_SCALE_TEXT=3.0
IRODORI_DEFAULT_CFG_SCALE_SPEAKER=5.0
IRODORI_DEFAULT_CFG_GUIDANCE_MODE=independent
# Unset uses the checkpoint recommendation (120 seconds for v4 Small; 30 seconds for legacy checkpoints).
# IRODORI_DEFAULT_MAX_REF_SECONDS=120
IRODORI_DEFAULT_CHUNKING_ENABLED=true
IRODORI_DEFAULT_CHUNK_MIN_CHARS=80
# IRODORI_DEFAULT_FIRST_SENTENCE_CHUNK_MIN_CHARS=1
